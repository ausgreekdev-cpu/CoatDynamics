{
  "name": "painter-saas",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "lint": "pnpm --filter web exec eslint src",
    "build:mobile": "pnpm --filter web build && pnpm --filter mobile exec cap sync",
    "test": "pnpm --filter web exec vitest run",
    "build:desktop": "cd apps/desktop && cargo tauri build",
    "typecheck": "pnpm --filter web exec tsc -b"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}