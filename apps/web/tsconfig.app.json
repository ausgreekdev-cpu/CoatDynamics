{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@painter/ui": ["../../packages/ui/src/index.ts"],
      "@painter/core": ["../../packages/core/src/index.ts"],
      "@painter/db": ["../../packages/db/src/index.ts"]
    }
  },
  "include": ["src"]
}